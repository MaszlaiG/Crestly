rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Nettli — fiókonként egy privát dokumentum: vaults/{uid}.
    // Bejelentkezés kötelező, és mindenki KIZÁRÓLAG a saját adatát éri el.
    match /vaults/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
